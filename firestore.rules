rules_version = '2';

// ===========================================================================
// Firestore-Sicherheitsregeln für Geometry Ultra (gehärtete Fassung)
//
// Grundprinzip:
//   - Bestenlisten sind ÖFFENTLICH lesbar.
//   - Schreiben nur für sich selbst (request.auth.uid muss passen).
//   - Strikte Typ-/Größen-/Wertevalidierung (inkl. photoURL = nur https).
//   - Scores können nur STEIGEN (nur-höher-Update), nicht abgesenkt werden.
//   - Realistischer Score-Deckel statt 100 Mio.
//
// Hinweis: Wasserdichter Cheat-Schutz bräuchte Cloud Functions; diese Regeln
// verhindern Fremd-Schreibzugriff und grob unrealistische / fehlerhafte Daten.
//
// EINSETZEN: Firebase-Console -> Firestore Database -> Tab "Regeln" ->
// diesen Inhalt einfügen -> "Veröffentlichen".
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -- Hilfsfunktionen --
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Realistischer Höchstwert (selbst sehr lange Läufe bleiben weit darunter;
    // ~46 units/s Maximaltempo => 250k entspräche über 1,5 Stunden Dauerlauf).
    function maxScore() {
      return 250000;
    }
    function validPhoto(data) {
      return !('photoURL' in data) || data.photoURL == null
          || (data.photoURL is string && data.photoURL.size() <= 300 && data.photoURL.matches('https://.*'));
    }
    function validScore(data) {
      return data.score is number
          && data.score >= 0
          && data.score <= maxScore()
          && data.displayName is string
          && data.displayName.size() <= 64
          && validPhoto(data);
    }
    function validGhost(data) {
      return data.score is number
          && data.score >= 0
          && data.score <= maxScore()
          && data.name is string
          && data.name.size() <= 64
          // interval/Listen streng validieren: ein manipuliertes Dokument würde
          // sonst die Geist-Wiedergabe ALLER Spieler des Tages zerlegen.
          && data.interval is number
          && data.interval > 0
          && data.interval <= 5
          && data.xs is list && data.xs.size() >= 1 && data.xs.size() <= 6000
          && data.ys is list && data.ys.size() == data.xs.size()
          && data.zs is list && data.zs.size() == data.xs.size();
    }

    // -- Globale Bestenliste (ein Dokument pro Nutzer, Doc-ID = uid) --
    match /scores/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && validScore(request.resource.data);
      // Update nur mit gleichem oder höherem Score (kein Absenken)
      allow update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && validScore(request.resource.data)
                    && request.resource.data.score >= resource.data.score;
    }

    // -- Tages-Challenge-Scores: dailyScores/<seed>/entries/<uid> --
    match /dailyScores/{seed}/entries/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && validScore(request.resource.data);
      allow update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && validScore(request.resource.data)
                    && request.resource.data.score >= resource.data.score;
    }

    // -- Tages-Geist: ein Dokument pro Seed (Doc-ID = seed), nur der Beste --
    match /dailyGhosts/{seed} {
      allow read: if true;
      // seed im Dokument MUSS zur Doc-ID passen — sonst kann ein Angreifer die
      // Geister beliebiger (auch zukünftiger) Tage vorab vergiften/blockieren.
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.seed == int(seed)
                    && validGhost(request.resource.data);
      // überschreiben nur mit höherem Score und weiterhin gültigen Daten
      allow update: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.seed == int(seed)
                    && validGhost(request.resource.data)
                    && request.resource.data.score > resource.data.score;
    }

    // -- Alles andere ist gesperrt --
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
